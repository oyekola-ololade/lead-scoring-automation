        "path": "lead-scoring",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "3e4bf1e9-1038-4a5e-b67a-1c5d7065cb72",
      "name": "Extract Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        450,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1121afd1-ce43-406d-a27e-68986f50e156",
              "name": "company_size",
              "value": "={{ $json.body.company_size }}",
              "type": "string"
            },
            {
              "id": "af6907e5-b95b-42c0-bf26-dffd6946c8fe",
              "name": "budget",
              "value": "={{ $json.body.budget }}",
              "type": "string"
            },
            {
              "id": "910971bb-96ac-49a4-83c2-59178dfc63fa",
              "name": "timeline",
              "value": "={{ $json.body.timeline }}",
              "type": "string"
            },
            {
              "id": "2a16dce5-d1f9-4b90-beb5-d76e19aa63ce",
              "name": "engagement",
              "value": "={{ $json.body.engagement_score || 0 }}",
              "type": "string"
            },
            {
              "id": "e32b79a1-f26b-4549-acb2-43d50a7e904f",
              "name": "email",
              "value": "={{ $json.body.email }}",
              "type": "string"
            },
            {
              "id": "4dc2e5b5-83df-4c70-8f4e-9f1c6825b278",
              "name": "name",
              "value": "={{ $json.body.name }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "18433a8d-ce22-450f-93f3-1081c059e4b5",
      "name": "Calculate Score",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        650,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a4f97bf9-dd11-4abb-aacf-15943b29daba",
              "name": "company_size_pts",
              "value": "={{ Math.min(parseInt($json.company_size) / 10, 100) }}",
              "type": "string"
            },
            {
              "id": "de161915-209a-4031-b5d8-f55efb7a42cb",
              "name": "budget_pts",
              "value": "={{ Math.min(parseInt($json.budget.replace(/[^0-9]/g, '')) / 10000, 100) }}",
              "type": "string"
            },
            {
              "id": "865eea73-51c6-4fe1-89ca-3fe391e7005c",
              "name": "timeline_pts",
              "value": "={{ Math.max(0, 100 - (parseInt($json.timeline) * 2)) }}",
              "type": "string"
            },
            {
              "id": "c02d7b4f-312e-4439-bc81-4fa1315b4cd0",
              "name": "engagement_pts",
              "value": "={{ parseInt($json.engagement) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "9ab7fd00-cb8b-4aad-888a-3a7c662fee84",
      "name": "Final Score",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        850,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1704bd24-5bac-4731-87d7-3c19448bc6a0",
              "name": "score",
              "value": "={{ Math.round(($json.company_size_pts * 0.2) + ($json.budget_pts * 0.3) + ($json.timeline_pts * 0.25) + ($json.engagement_pts * 0.25)) }}",
              "type": "string"
            },
            {
              "id": "78847ce7-a5d0-4be7-87f0-9ff76b5efe77",
              "name": "tier",
              "value": "={{ $json.score >= 80 ? 'HOT' : $json.score >= 50 ? 'WARM' : 'COLD' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "2a517093-dc63-4644-b7d1-0cb5146669b7",
      "name": "Score Tier",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1050,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "78820cbc-f167-4d73-9b9e-197e16d23a3a",
              "leftValue": "={{ $json.score }}",
              "rightValue": 80,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ]
        }
      }
    },
